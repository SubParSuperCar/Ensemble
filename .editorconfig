root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.cmd]
end_of_line = crlf

# XML-like, excluding Avalonia XAML
[*.{csproj,nsdepcop,props,slnx,xml}]
indent_size = 2
ij_xml_space_inside_empty_tag = false

# noinspection EditorConfigKeyCorrectness
resharper_xml_space_before_self_closing = false

# Source code
[*.{cmd,cs,gd,gdshader,gdshaderinc,sh}]
indent_style = tab
indent_size = 4
max_line_length = 120

# noinspection EditorConfigKeyCorrectness
[*.cs]
csharp_indent_case_contents_when_block = false
csharp_new_line_before_members_in_object_initializers = false
csharp_prefer_braces = false
csharp_preserve_single_line_blocks = true
csharp_style_expression_bodied_methods = true:suggestion

csharp_keep_existing_expr_member_arrangement = false
resharper_braces_for_dowhile = not_required
resharper_braces_for_fixed = not_required
resharper_braces_for_for = not_required
resharper_braces_for_foreach = not_required
resharper_braces_for_ifelse = not_required
resharper_braces_for_lock = not_required
resharper_braces_for_using = not_required
resharper_braces_for_while = not_required
resharper_braces_redundant = true
resharper_csharp_alignment_tab_fill_style = optimal_fill
resharper_csharp_indent_nested_for_stmt = true
resharper_csharp_indent_nested_foreach_stmt = true
resharper_csharp_indent_nested_while_stmt = true
resharper_csharp_wrap_before_arrow_with_expressions = false

resharper_check_namespace_highlighting = none
resharper_lambda_expression_can_be_made_static_highlighting = suggestion

dotnet_diagnostic.NSDEPCOP01.severity = warning

dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.MA0003.severity = none
dotnet_diagnostic.MA0007.severity = none
dotnet_diagnostic.MA0026.severity = none
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0041.severity = none
dotnet_diagnostic.MA0046.severity = none
dotnet_diagnostic.MA0048.severity = none
dotnet_diagnostic.MA0049.severity = none
dotnet_diagnostic.MA0127.severity = none
dotnet_diagnostic.MA0136.severity = none
dotnet_diagnostic.MA0148.severity = warning
dotnet_diagnostic.MA0149.severity = warning
dotnet_diagnostic.MA0197.severity = none
dotnet_diagnostic.MA0219.severity = none
