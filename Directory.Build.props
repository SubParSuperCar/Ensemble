<Project>

  <PropertyGroup>
    <Authors>SubParSuperCar</Authors>
    <Product>Ensemble</Product>
    <Description>Ensemble - A multiplayer, collaborative sandbox building game made with Godot 4, C#, .NET, and Avalonia 12.</Description>
    <Copyright>Copyright (c) 2026-$([System.DateTime]::Now.ToString('yyyy')) $(Authors)</Copyright>
  </PropertyGroup>

  <!-- Estragonia is vendored and keeps upstream's code, so it isn't held to Ensemble's analyzers -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Estragonia'">
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.296">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
