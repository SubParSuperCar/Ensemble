<Project>

  <PropertyGroup>
    <Authors>SubParSuperCar</Authors>
    <Product>Ensemble</Product>
    <Description>Ensemble - A multiplayer, collaborative sandbox building game made with Godot 4, C#, .NET, and Avalonia 12.</Description>
    <Copyright>Copyright (c) 2026-$([System.DateTime]::Now.ToString('yyyy')) $(Authors)</Copyright>
  </PropertyGroup>

  <!-- Estragonia is vendored and has its own Directory.Build.props, so it skips this file and these analyzers -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
