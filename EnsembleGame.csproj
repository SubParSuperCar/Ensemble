<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <Configurations>Debug;Release;ExportDebug;ExportRelease</Configurations>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EnsembleGame</AssemblyName>
    <RootNamespace>EnsembleRoot</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Makes embedded source paths relative to the project directory, for privacy and brevity -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>

    <LaunchScriptExt>sh</LaunchScriptExt>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">
    <!-- Copies every assembly (particularly NuGet ones) to the output directory -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <!-- Keeps Release output in Debug for Godot's editor workflow -->
    <OutputPath>$(GodotProjectDir).godot/mono/temp/bin/Debug/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ExportRelease'">
    <DefineConstants>$(DefineConstants);ENSEMBLE_RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'ExportDebug'">
    <DefineConstants>$(DefineConstants);ENSEMBLE_DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ExportDebug' Or '$(Configuration)' == 'ExportRelease'">
    <DefineConstants>$(DefineConstants);EXPORT</DefineConstants>
  </PropertyGroup>

  <!-- Only releases are NativeAOT; everything else, including debug exports, is JIT-compiled -->
  <PropertyGroup Condition="('$(Configuration)' == 'Release' Or '$(Configuration)' == 'ExportRelease') And '$(EnsembleJit)' != 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <!-- Only affects NativeAOT; Avalonia and Lua are hot managed code, and the size cost is small next to the engine -->
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <Choose>
    <When Condition="'$(OS)' == 'Windows_NT'">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);OS_WINDOWS</DefineConstants>
        <LaunchScriptExt>cmd</LaunchScriptExt>
      </PropertyGroup>
    </When>

    <When Condition="Exists('/System/Library/CoreServices')">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);OS_MAC</DefineConstants>
      </PropertyGroup>
    </When>

    <Otherwise>
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);OS_LINUX</DefineConstants>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <TrimmerRootAssembly Include="$(TargetName)"/>
    <TrimmerRootAssembly Include="GodotSharp"/>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.AvaloniaEdit"/>
    <PackageReference Include="Avalonia.Controls.WebView"/>
    <!-- Excluded in favor of the patched Avalonia.Skia referenced below, which every assembly must use -->
    <PackageReference Include="Avalonia.Skia" IncludeAssets="none"/>
    <PackageReference Include="Avalonia.Themes.Simple"/>
    <PackageReference Include="Avalonia.Wayland"/>
    <PackageReference Include="Avalonia.X11"/>
    <PackageReference Include="AvaloniaEdit.TextMate"/>
    <PackageReference
      Include="AvaloniaUI.DiagnosticsSupport"
      Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'ExportDebug'"/>
    <PackageReference Include="BogaNet.TTS"/>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="DiscordRichPresence"/>
    <PackageReference Include="Fonts.Avalonia.JetBrainsMono"/>
    <PackageReference Include="Hardware.Info.Aot"/>
    <PackageReference Include="Iciclecreek.Avalonia.Terminal"/>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2"/>
    <PackageReference Include="LiveMarkdown.Avalonia"/>
    <PackageReference Include="LiveMarkdown.Avalonia.Mermaid"/>
    <PackageReference Include="LiveMarkdown.Avalonia.Svg.Skia"/>
    <PackageReference Include="LuaCSharp"/>
    <PackageReference Include="MethodBoundaryAspect.Fody"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="NsDepCop">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Optris.LoadingIndicators.Avalonia"/>
    <PackageReference Include="Serilog"/>
    <PackageReference Include="Serilog.Expressions"/>
    <PackageReference Include="Serilog.Extensions.Logging"/>
    <PackageReference Include="Serilog.Settings.Configuration"/>
    <PackageReference Include="Serilog.Sinks.Console"/>
    <PackageReference Include="Serilog.Sinks.File"/>
    <PackageReference Include="Serilog.Sinks.File.Header"/>
    <PackageReference Include="ServiceScan.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Threading.RateLimiting"/>
    <PackageReference Include="TinyDialogsNet"/>
    <PackageReference Include="ZstdSharp.Port"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="AutoloadGenerator/AutoloadGenerator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="Core/Core.csproj"/>
    <ProjectReference Include="Estragonia/Estragonia.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Avalonia.Skia">
      <HintPath>Estragonia/Lib/Avalonia.Skia.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Published beside the executable, for the in-game document viewer -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" CopyToPublishDirectory="PreserveNewest"/>
    <None Include="$(MSBuildThisFileDirectory).github/LICENSE-*.txt" CopyToPublishDirectory="PreserveNewest">
      <Link>.github/%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- Shown in the IDE only -->
  <ItemGroup>
    <None Include="**/*.gd;**/*.gdshader;**/*.gdshaderinc;assets/**" Exclude=".godot/**;bin/**;**/*.import;**/*.mp3">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="**/*.tscn;**/*.scn" Exclude=".godot/**;bin/**;scenes/**"/>
    <None Include="Common/Text/ProfanityList.LICENSE.txt"/>
    <None Include="Properties/**" Exclude="**/*.gdignore"/>
  </ItemGroup>

  <!-- A script nests under the same-named scene beside it (Motor.cs under Motor.tscn), as .axaml.cs under .axaml -->
  <ItemGroup>
    <Compile Update="**/*.cs">
      <DependentUpon Condition="Exists('%(RootDir)%(Directory)%(Filename).tscn')">%(Filename).tscn</DependentUpon>
      <DependentUpon Condition="Exists('%(RootDir)%(Directory)%(Filename).scn')">%(Filename).scn</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Common/Text/ProfanityList.json.gz" LogicalName="EnsembleRoot.Common.Text.ProfanityList.json.gz"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AutoloadGenerator/**"/>
    <Compile Remove="Core/**"/>
    <Compile Remove="Estragonia/**"/>
    <Compile Remove="Tests/**"/>

    <EmbeddedResource Remove="AutoloadGenerator/**"/>
    <EmbeddedResource Remove="Core/**"/>
    <EmbeddedResource Remove="Estragonia/**"/>
    <EmbeddedResource Remove="Tests/**"/>
  </ItemGroup>

  <!-- Regenerated only when the build's inputs change, so up-to-date builds don't recompile for a new time -->
  <Target
    Name="GenerateBuildInfo"
    Inputs="@(Compile);@(AvaloniaXaml);@(ReferencePath);$(MSBuildAllProjects)"
    Outputs="$(IntermediateOutputPath)BuildInfo.g.cs">

    <PropertyGroup>
      <BuildTime>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss UTC"))</BuildTime>
    </PropertyGroup>

    <ItemGroup>
      <BuildInfoLines Include="public static class BuildInfo"/>
      <BuildInfoLines Include="{"/>
      <BuildInfoLines Include="&#9;public const string BuildTime = &quot;$(BuildTime)&quot;%3B"/>
      <BuildInfoLines Include="&#9;public static bool IsNativeAot => !System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported%3B"/>
      <BuildInfoLines Include="}"/>
    </ItemGroup>

    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Lines="@(BuildInfoLines)" Overwrite="true"/>
  </Target>

  <Target Name="IncludeBuildInfo" BeforeTargets="BeforeCompile" DependsOnTargets="GenerateBuildInfo">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs"/>
    </ItemGroup>
  </Target>

  <Target Name="PrepareGodotExport" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)/bin/linux"/>
    <MakeDir Directories="$(MSBuildProjectDirectory)/bin/macos"/>
    <MakeDir Directories="$(MSBuildProjectDirectory)/bin/windows"/>

    <WriteLinesToFile File="$(MSBuildProjectDirectory)/bin/.gdignore" Lines="" Overwrite="false"/>
  </Target>

</Project>
