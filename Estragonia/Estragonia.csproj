<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyTitle>Estragonia</AssemblyTitle>

    <!-- Framework/Language -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AnalysisMode>Recommended</AnalysisMode>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Access Avalonia internal/private APIs needed for platform backend implementation -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>true</Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.7.2"/>
    <PackageReference Include="Avalonia" Version="[12.1.1]"/>
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1"/>
    <PackageReference Include="SkiaSharp" Version="3.119.4"/>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"/>
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Avalonia.Skia">
      <HintPath>lib/Avalonia.Skia.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Remove=".gdignore"/>
  </ItemGroup>

</Project>
