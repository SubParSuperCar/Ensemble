<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <AssemblyName>Game</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisMode>Recommended</AnalysisMode>
    <RootNamespace>Root</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles> -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'ExportDebug'">
    <DefineConstants>$(DefineConstants);ENSEMBLE_DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ExportRelease'">
    <DefineConstants>$(DefineConstants);ENSEMBLE_RELEASE</DefineConstants>
    <OptimizationPreference>Speed</OptimizationPreference>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishSelfContained>true</PublishSelfContained>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="$(TargetName)"/>
    <TrimmerRootAssembly Include="GodotSharp"/>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.*"/>
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.*"/>
    <!-- Pin Avalonia.Skia to the patched 12.1.1 build -->
    <PackageReference Include="Avalonia.Skia" Version="[12.1.1]" IncludeAssets="none"/>
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.*"/>
    <PackageReference Include="Avalonia.Wayland" Version="12.*"/>
    <PackageReference Include="Avalonia.X11" Version="12.*"/>
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.*"/>
    <PackageReference Include="BogaNet.TTS" Version="1.4.0"/>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70"/>
    <PackageReference Include="Fonts.Avalonia.JetBrainsMono" Version="0.14.0"/>
    <PackageReference Include="Hardware.Info" Version="110.0.0.1"/>
    <PackageReference Include="LuaCSharp" Version="0.5.6"/>
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.0-a3"/>
    <PackageReference Include="MethodBoundaryAspect.Fody" Version="2.0.150"/>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.177">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.*"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*"/>
    <PackageReference Include="Optris.LoadingIndicators.Avalonia" Version="12.*"/>
    <PackageReference Include="Serilog" Version="4.4.0"/>
    <PackageReference Include="Serilog.Expressions" Version="5.0.0"/>
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0"/>
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1"/>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
    <PackageReference Include="ServiceScan.SourceGenerator" Version="3.2.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.*"/>
    <PackageReference Include="TinyDialogsNet" Version="2.0.0"/>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="lib/estragonia/Estragonia.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Required by the Avalonia designer and WebView -->
    <Reference Include="Avalonia.Skia">
      <HintPath>lib/estragonia/lib/Avalonia.Skia.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <LaunchScriptExt>cmd</LaunchScriptExt>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <LaunchScriptExt>sh</LaunchScriptExt>
  </PropertyGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <BuildTime>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss UTC"))</BuildTime>
    </PropertyGroup>

    <ItemGroup>
      <BuildInfoLines Include="public static class BuildInfo"/>
      <BuildInfoLines Include="{"/>
      <BuildInfoLines Include="&#x9;public const string BuildTime = &quot;$(BuildTime)&quot;%3B"/>
      <BuildInfoLines Include="}"/>
    </ItemGroup>

    <WriteLinesToFile
      File="$(IntermediateOutputPath)BuildInfo.g.cs"
      Lines="@(BuildInfoLines)"
      Overwrite="true"/>

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs"/>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None
      Include="$(MSBuildThisFileDirectory)LICENSE.md"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>

  <Target Name="CreateExportDirs" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)/bin/linux"/>
    <MakeDir Directories="$(MSBuildProjectDirectory)/bin/windows"/>

    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/bin/.gdignore"
      Lines=""
      Overwrite="false"/>
  </Target>

  <ItemGroup>
    <Content Include="**/*.gd;**/*.gdshader" Exclude=".godot/**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Directory.Build.props"/>
    <Content Include="Properties/**" Exclude="**/*.gdignore"/>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="lib/**"/>
    <Compile Remove="lib/**"/>
    <EmbeddedResource Remove="lib/**"/>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="bin/**"/>
    <Compile Remove="bin/**"/>
    <EmbeddedResource Remove="bin/**"/>
    <AvaloniaXaml Remove="bin/**"/>
    <AdditionalFiles Remove="bin/**"/>
    <AvaloniaResource Remove="bin/**"/>
  </ItemGroup>
</Project>
