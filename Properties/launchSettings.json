{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Player (PATH Launcher)": {
      "commandName": "Executable",
      "executablePath": "Properties/launch.$(LaunchScriptExt)",
      "workingDirectory": "$(ProjectDir)",
      "commandLineArgs": "--verbose --path \"$(ProjectDir)"
    },
    "Editor (PATH Launcher)": {
      "commandName": "Executable",
      "executablePath": "Properties/launch.$(LaunchScriptExt)",
      "workingDirectory": "$(ProjectDir)",
      "commandLineArgs": "--editor --verbose --path \"$(ProjectDir)"
    }
  }
}
