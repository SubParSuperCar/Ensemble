<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Root.Ui.Impl.App"
    RequestedThemeVariant="Dark">

    <Application.Styles>
        <SimpleTheme />

        <Style Selector=":is(TopLevel)">
            <Setter Property="FontFamily" Value="avares://Fonts.Avalonia.JetBrainsMono/Assets#JetBrains Mono" />
        </Style>
    </Application.Styles>

</Application>
