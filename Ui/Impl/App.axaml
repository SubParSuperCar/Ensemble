<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:e="using:EnsembleRoot.Ui.Easings"
    x:Class="EnsembleRoot.Ui.App"
    RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Font">
                avares://Fonts.Avalonia.JetBrainsMono/Assets#JetBrains Mono
            </FontFamily>

            <FontWeight x:Key="FontWeight">Light</FontWeight>
            <x:Double x:Key="FontSize">16</x:Double>
            <x:Double x:Key="MenuFontSize">11</x:Double>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LoadingIndicators.Avalonia/LoadingIndicators.axaml" />
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
                <ResourceInclude Source="Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush
                x:Key="TranslucentBackgroundBrush"
                Color="{DynamicResource ThemeBackgroundColor}"
                Opacity="0.625" />

            <SolidColorBrush x:Key="PrimaryBrush" Color="#40A0FF" />
            <SolidColorBrush x:Key="DangerBrush" Color="Red" />

            <Thickness x:Key="BorderThickness">1.5</Thickness>

            <e:EaseInEasing x:Key="EaseIn" />
            <e:EaseOutEasing x:Key="EaseOut" />
            <e:EaseInOutEasing x:Key="EaseInOut" />

            <DropShadowEffect
                x:Key="StrokeEffect"
                OffsetX="0" OffsetY="0"
                BlurRadius="0.25" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />

        <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia.Mermaid/Styles.axaml" />

        <!-- SimpleTheme gives popup hosts and menus their own fonts, so they would not inherit the window's -->
        <Style Selector=":is(TopLevel), OverlayPopupHost, ContextMenu, MenuFlyoutPresenter">
            <Setter Property="FontFamily" Value="{StaticResource Font}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize}" />
        </Style>

        <StyleInclude Source="Styles/Markdown.axaml" />
        <StyleInclude Source="Styles/Controls.axaml" />
        <StyleInclude Source="Styles/Menus.axaml" />
        <StyleInclude Source="Styles/Classes.axaml" />
    </Application.Styles>

</Application>
