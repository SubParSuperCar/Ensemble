<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="using:EnsembleRoot.Common">

    <Style Selector="ScrollBar /template/ Thumb#thumb">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb#thumb:pointerover, ScrollBar /template/ Thumb#thumb:pressed">
        <Setter Property="Background" Value="{DynamicResource HighlightBrush}" />
    </Style>

    <!-- The flyouts' gap from what opens them, which SimpleTheme's drop-down lists lack -->
    <Style Selector="ComboBox /template/ Popup#PART_Popup">
        <Setter Property="Placement" Value="Top" />
        <Setter Property="VerticalOffset" Value="-2" />
    </Style>

    <!-- SimpleTheme insets its text box by a margin as well as this padding, which made it taller than a text box -->
    <Style Selector="NumericUpDown">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- An empty box is only a binding's error, as it keeps its last good value; NumberBoxes shows the real ones -->
    <Style Selector="NumericUpDown /template/ DataValidationErrors">
        <Setter Property="ErrorTemplate">
            <DataTemplate>
                <Panel />
            </DataTemplate>
        </Setter>
    </Style>

    <Style Selector="NumericUpDown.invalid /template/ TextBox#PART_TextBox">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style Selector="ToggleButton:checked:not(.plain) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HighlightBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HighlightForegroundBrush}" />
    </Style>

    <!-- Capped at the window's width, where text tips wrap rather than run off it -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{StaticResource TranslucentBackgroundBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="MaxWidth" Value="{Binding $parent[TopLevel].Bounds.Width}" />
    </Style>

    <Style Selector="ToolTip /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0" />

        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="{x:Static cm:Constants.AnimationDuration}" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ToolTip:open /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="1" />
    </Style>

</Styles>
