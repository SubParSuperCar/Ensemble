<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EnsembleRoot.Ui.ViewModels"
    xmlns:c="using:EnsembleRoot.Ui.Controls"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="EnsembleRoot.Ui.Views.ClockView"
    x:DataType="vm:ClockViewModel">

    <!-- Only the time flips, as the session duration changes every frame -->
    <Border
        Background="{DynamicResource TranslucentBackgroundBrush}"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        Padding="2"
        IsHitTestVisible="False">

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Date}" />
            <c:FlipText Text="{Binding Time}" />
            <TextBlock Text="{Binding Details}" />
        </StackPanel>
    </Border>

</UserControl>
