<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EnsembleRoot.Ui.ViewModels"
    xmlns:cm="using:EnsembleRoot.Common"
    xmlns:ae="using:AvaloniaEdit"
    xmlns:aee="using:AvaloniaEdit.Editing"
    mc:Ignorable="d" d:DesignWidth="448" d:DesignHeight="256"
    x:Class="EnsembleRoot.Ui.Views.LogOutputView"
    x:DataType="vm:LogOutputViewModel">

    <UserControl.Styles>
        <Style Selector="aee|TextArea">
            <Setter Property="SelectionForeground" Value="Black" />
            <Setter Property="SelectionBorder" Value="{x:Null}" />
            <Setter Property="SelectionCornerRadius" Value="0" />
        </Style>

        <!-- Only while there's a selection, as an endless animation would redraw the output every frame -->
        <Style Selector="aee|TextArea.selection">
            <Style.Animations>
                <Animation
                    Duration="{x:Static cm:Constants.AnimationDuration}"
                    IterationCount="Infinite"
                    PlaybackDirection="Alternate">

                    <KeyFrame Cue="0%">
                        <Setter Property="SelectionBrush" Value="Yellow" />
                    </KeyFrame>

                    <KeyFrame Cue="100%">
                        <Setter Property="SelectionBrush" Value="Orange" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- This view's gaps are 4 px, not the app's usual 2 -->
        <Style Selector="ComboBox /template/ Popup#PART_Popup">
            <Setter Property="VerticalOffset" Value="-4" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Shows the lines in view alone, as laying out the whole log again for each entry stalled frames -->
        <ae:TextEditor
            Name="Output"
            Document="{Binding Output}"
            Watermark="&lt;Empty&gt;"
            TemplateApplied="OnOutputTemplateApplied"
            Background="Black" Foreground="White"
            Padding="1"
            FontSize="12" FontWeight="ExtraLight"
            IsReadOnly="True"
            WordWrap="True">

            <ae:TextEditor.Options>
                <ae:TextEditorOptions AllowScrollBelowDocument="False" />
            </ae:TextEditor.Options>
        </ae:TextEditor>

        <TextBlock
            Name="SourceLabel"
            Text="&#x2199; Game and Engine Logs"
            ToolTip.Tip="The game's logs, plus everything the engine reports&#x0a;(its errors, its warnings, and its prints as verbose)."
            Background="#80000000" Foreground="Cyan"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,2,2,0"
            FontSize="10" FontWeight="ExtraLight" FontStyle="Italic" />

        <!-- Wraps upward when the output is too narrow for one row -->
        <WrapPanel
            Name="Actions"
            ItemSpacing="4" LineSpacing="4"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,4,4"
            ItemsAlignment="End">

            <ComboBox
                ItemsSource="{x:Static vm:LogOutputViewModel.Levels}"
                SelectedItem="{Binding MinimumLevel}"
                ToolTip.Tip="Hides log entries below the selected severity level."
                Background="{DynamicResource TranslucentBackgroundBrush}" />

            <Button
                Content="Open User Data Dir."
                Command="{Binding OpenUserDataDirCommand}"
                ToolTip.Tip="Opens the directory where user data are stored."
                Background="{DynamicResource TranslucentBackgroundBrush}" />

            <NumericUpDown
                Value="{Binding #Output.FontSize, Mode=TwoWay}"
                PlaceholderText="&lt;Font Size Px.&gt;"
                ToolTip.Tip="Sets the output font size, in device-independent pixels (scaled with the UI)."
                Background="{DynamicResource TranslucentBackgroundBrush}"
                Minimum="1"
                Increment="0.5" />
        </WrapPanel>
    </Grid>

</UserControl>
