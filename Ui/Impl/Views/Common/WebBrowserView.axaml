<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Root.Ui.Impl.ViewModels"
    xmlns:li="using:LoadingIndicators.Avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="Root.Ui.Impl.Views.WebBrowserView"
    x:DataType="vm:WebBrowserViewModel"
    x:Name="Root"
    TextOptions.TextRenderingMode="Antialias">

    <Grid>
        <TextBlock
            Text="The Web View is not rendering.&#x0a;Do you have WebView2, WebKitGTK, or WPE WebKit?"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            FontSize="32" FontWeight="SemiBold"
            TextAlignment="Center" />

        <NativeWebView
            Name="WebView"
            Source="https://www.google.com/"
            GotFocus="OnWebViewGotFocus"
            LostFocus="OnWebViewLostFocus"
            NavigationStarted="OnWebViewNavigationStarted"
            NavigationCompleted="OnWebViewNavigationCompleted"
            EnvironmentRequested="OnWebViewEnvironmentRequested"
            AdapterCreated="OnWebViewAdapterCreated"
            AdapterDestroyed="OnWebViewAdapterDestroyed" />

        <StackPanel
            Orientation="Horizontal" Spacing="2"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="2">

            <Button Content="&lt;-" Command="{Binding #Root.GoBackCommand}" ToolTip.Tip="Go back (Undo)" />
            <Button Content="-&gt;" Command="{Binding #Root.GoForwardCommand}" ToolTip.Tip="Go forward (Redo)" />

            <Button
                Command="{Binding #Root.RefreshOrStopCommand}"
                ToolTip.Tip="Refresh/cancel"
                Width="32" Height="32">

                <li:LoadingIndicator
                    Name="LoadingIndicator"
                    Mode="FlipPlane"
                    Foreground="#00C000" />
            </Button>

            <TextBox
                Name="UrlBox"
                Text="{Binding #WebView.Source, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                PlaceholderText="Type URI here &amp; press Enter to navigate"
                KeyDown="OnUrlBoxKeyDown"
                ToolTip.Tip="The current URI. Type and press Enter to navigate.&#x0a;Use the 'file://' scheme to browse local files."
                MinWidth="256" MaxWidth="512" />
        </StackPanel>
    </Grid>

</UserControl>
