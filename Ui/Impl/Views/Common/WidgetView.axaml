<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="240"
    x:Class="EnsembleRoot.Ui.Impl.Views.WidgetView"
    x:DataType="vm:WidgetViewModel"
    TextOptions.TextRenderingMode="Antialias">

    <UserControl.Styles>
        <Style Selector="Border#Outline">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlMidBrush}" />
        </Style>

        <Style Selector="Panel#Frame.active Border#Outline">
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightBrush}" />
        </Style>

        <Style Selector="Grid#Header">
            <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
        </Style>

        <Style Selector="Panel#Frame.active Grid#Header">
            <Setter Property="Background" Value="{DynamicResource HighlightBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource HighlightForegroundBrush}" />
        </Style>

        <Style Selector="Button#MaximizeButton">
            <Setter Property="Content" Value="&#x25A1;" />
        </Style>

        <Style Selector="Panel#Frame.maximized Button#MaximizeButton">
            <Setter Property="Content" Value="&#x25A3;" />
        </Style>

        <Style Selector="Grid#Header Button">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </UserControl.Styles>

    <!-- Unclipped, since Avalonia clips a visual before applying its effect; the outline is layered above the content -->
    <Panel
        Name="Frame"
        Classes="fade"
        Classes.active="{Binding IsActive}"
        Classes.hidden="{Binding IsClosing}"
        Classes.maximized="{Binding IsMaximized}">

        <Panel.Effect>
            <DropShadowEffect
                OffsetX="0" OffsetY="2"
                BlurRadius="16" Opacity="0.5" />
        </Panel.Effect>

        <Border Name="Body" SizeChanged="OnBodySizeChanged">
            <Grid RowDefinitions="24,*" Margin="2">
                <Grid
                    Name="Header"
                    ColumnDefinitions="*,Auto,Auto"
                    PointerPressed="OnHeaderPointerPressed"
                    PointerMoved="OnDragPointerMoved"
                    PointerReleased="OnDragPointerReleased"
                    PointerCaptureLost="OnDragPointerCaptureLost"
                    DoubleTapped="OnHeaderDoubleTapped"
                    ToolTip.Tip="{Binding Descriptor.Description}"
                    Cursor="SizeAll">

                    <TextBlock
                        Text="{Binding Title}"
                        VerticalAlignment="Center"
                        Margin="8,0"
                        TextTrimming="CharacterEllipsis" />

                    <Button
                        Name="MaximizeButton"
                        Grid.Column="1"
                        Command="{Binding ToggleMaximizedCommand}"
                        ToolTip.Tip="Maximizes or restores this widget. (Or double-click the header)"
                        CornerRadius="4,0,0,0" />

                    <Button
                        Grid.Column="2"
                        Content="X"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="Closes this widget."
                        Background="Red" Foreground="White"
                        CornerRadius="0,4,0,0"
                        FontWeight="Bold" />
                </Grid>

                <ContentControl Grid.Row="1" Content="{Binding Content}" />

                <Border
                    Grid.Row="1"
                    PointerPressed="OnResizeGripPointerPressed"
                    PointerMoved="OnDragPointerMoved"
                    PointerReleased="OnDragPointerReleased"
                    PointerCaptureLost="OnDragPointerCaptureLost"
                    ToolTip.Tip="Resizes this widget."
                    Background="{DynamicResource PrimaryBrush}"
                    Cursor="BottomRightCorner"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="12" Height="12"
                    CornerRadius="6,0,4,0"
                    IsVisible="{Binding Descriptor.IsResizable}" />
            </Grid>
        </Border>

        <Border Name="Outline" BorderThickness="2" CornerRadius="6" />
    </Panel>

</UserControl>
