<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    xmlns:g="clr-namespace:EnsembleRoot.Globals"
    xmlns:e="using:EnsembleRoot.Ui.Impl.Easings"
    xmlns:v="using:EnsembleRoot.Ui.Impl.Views"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="EnsembleRoot.Ui.Impl.Views.GameView"
    x:DataType="vm:GameViewModel"
    TextOptions.TextRenderingMode="Antialias">

    <Grid>
        <!-- Widgets render below the ribbon, the ToolBar, the player list, and the overlays -->
        <Grid RowDefinitions="Auto,4,*,Auto">
            <Grid>
                <Border
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1.5"
                    HorizontalAlignment="Left" VerticalAlignment="Top">

                    <Button
                        Content="&lt;- Menu | Quit Session (2x)"
                        DoubleTapped="OnMenuButtonDoubleTapped"
                        ToolTip.Tip="Stops the current session and returns to the menu. (Double-click)"
                        Background="{DynamicResource TranslucentBackgroundBrush}" />
                </Border>

                <ContentControl
                    Content="{Binding Clock}"
                    HorizontalAlignment="Center" VerticalAlignment="Top" />
            </Grid>

            <Grid Grid.Row="2">
                <v:WidgetDesktopView DataContext="{Binding Widgets}" />

                <TransitioningContentControl
                    Content="{Binding PlayerList}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MinWidth="288" MaxWidth="512" MaxHeight="384"
                    ClipToBounds="False">

                    <TransitioningContentControl.PageTransition>
                        <CompositePageTransition>
                            <CrossFade Duration="{x:Static g:Constants.AnimationDuration}" />
                            <Rotate3DTransition
                                Orientation="Vertical"
                                Duration="{x:Static g:Constants.AnimationDuration}" />
                        </CompositePageTransition>
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Grid>

            <TransitioningContentControl
                Grid.Row="3"
                Content="{Binding ToolBar}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">

                <TransitioningContentControl.PageTransition>
                    <CompositePageTransition>
                        <PageSlide
                            Orientation="Vertical"
                            Duration="{x:Static g:Constants.AnimationDuration}"
                            SlideInEasing="CubicEaseOut">

                            <PageSlide.SlideOutEasing>
                                <e:ZeroEasing />
                            </PageSlide.SlideOutEasing>
                        </PageSlide>

                        <CrossFade
                            Duration="{x:Static g:Constants.AnimationDuration}"
                            FadeInEasing="CubicEaseOut" />
                    </CompositePageTransition>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>

        <ContentControl
            Content="{Binding WidgetDrawer}"
            HorizontalAlignment="Left" VerticalAlignment="Center" />
    </Grid>

</UserControl>
