<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.ViewModels"
    xmlns:cm="clr-namespace:EnsembleRoot.Common"
    xmlns:e="using:EnsembleRoot.Ui.Easings"
    xmlns:v="using:EnsembleRoot.Ui.Views"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="EnsembleRoot.Ui.Views.GameView"
    x:DataType="vm:GameViewModel">

    <Grid>
        <!-- Widgets render below the ribbon, the ToolBar, the player list, and the overlays -->
        <Grid RowDefinitions="Auto,4,*,Auto">
            <Border
                BorderBrush="{StaticResource DangerBrush}" BorderThickness="{StaticResource BorderThickness}"
                HorizontalAlignment="Left" VerticalAlignment="Top">

                <Button
                    Content="&lt;- Menu | Quit Session (2x)"
                    DoubleTapped="OnMenuButtonDoubleTapped"
                    ToolTip.Tip="Stops the current session and returns to the menu. (Double-click)"
                    Background="{DynamicResource TranslucentBackgroundBrush}" />
            </Border>

            <Grid Grid.Row="2">
                <v:WidgetDesktopView DataContext="{Binding Widgets}" />

                <TransitioningContentControl
                    Content="{Binding PlayerList}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MinWidth="288" MaxWidth="512" MaxHeight="384"
                    ClipToBounds="False">

                    <TransitioningContentControl.PageTransition>
                        <CompositePageTransition>
                            <CrossFade Duration="{x:Static cm:Constants.AnimationDuration}" />
                            <Rotate3DTransition
                                Orientation="Vertical"
                                Duration="{x:Static cm:Constants.AnimationDuration}" />
                        </CompositePageTransition>
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Grid>

            <TransitioningContentControl
                Grid.Row="3"
                Content="{Binding ToolBar}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">

                <TransitioningContentControl.PageTransition>
                    <CompositePageTransition>
                        <PageSlide
                            Orientation="Vertical"
                            Duration="{x:Static cm:Constants.AnimationDuration}"
                            SlideInEasing="CubicEaseOut">

                            <PageSlide.SlideOutEasing>
                                <e:ZeroEasing />
                            </PageSlide.SlideOutEasing>
                        </PageSlide>

                        <CrossFade
                            Duration="{x:Static cm:Constants.AnimationDuration}"
                            FadeInEasing="CubicEaseOut" />
                    </CompositePageTransition>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>

        <ContentControl
            Content="{Binding WidgetDrawer}"
            HorizontalAlignment="Left" VerticalAlignment="Center" />

        <!-- Drawn above the widgets and the ToolBar, since it's essential, and outside the footer -->
        <TransitioningContentControl
            Content="{Binding SpawnButton}"
            HorizontalAlignment="Left" VerticalAlignment="Bottom">

            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="{x:Static cm:Constants.AnimationDuration}" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <!-- Drawn above the rest of the game view -->
        <ContentControl Content="{Binding Marquee}" IsHitTestVisible="False" />
    </Grid>

</UserControl>
