<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EnsembleRoot.Ui.ViewModels"
    xmlns:c="using:EnsembleRoot.Ui.Controls"
    xmlns:cp="using:Avalonia.Controls.Primitives"
    mc:Ignorable="d" d:DesignWidth="512" d:DesignHeight="384"
    x:Class="EnsembleRoot.Ui.Views.PaintPaletteView"
    x:DataType="vm:PaintPaletteViewModel">

    <UserControl.Styles>
        <!-- A side whose part of the brush isn't applied stays editable, for when it is again -->
        <Style Selector=":is(Panel).dimmed">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- At the widget's top, unlike the other drop-down lists, so this one opens downward -->
        <Style Selector="ComboBox.below /template/ Popup#PART_Popup">
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="VerticalOffset" Value="2" />
        </Style>

        <!-- Compact, and in the plain text color, as the swatches have little room -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="{StaticResource FontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,1" />
        </Style>

        <!-- Rounded like the number boxes (in HSV only). Setting it also places the thumb, which a slider otherwise skips
             while its color, component, and model all keep their defaults (white, the first, and RGB) -->
        <Style Selector="cp|ColorSlider.component">
            <Setter Property="IsRoundingEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="NumericUpDown.component">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="FormatString" Value="0" />
            <Setter Property="ParsingNumberStyle" Value="Integer" />
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="Width" Value="52" />
        </Style>

        <!-- About as tall as the text, leaving the swatches more room -->
        <Style Selector="NumericUpDown.component /template/ TextBox#PART_TextBox">
            <Setter Property="Margin" Value="4,1" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource TranslucentBackgroundBrush}" Padding="2">
        <Grid RowDefinitions="Auto,*" RowSpacing="2">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                <TextBox
                    Text="{Binding ColorText, UpdateSourceTrigger=LostFocus}"
                    ToolTip.Tip="The brush's color as text. Type hex (#RRGGBB or #RRGGBBAA) or values separated by&#x0a;commas (R, G, B, A, or H, S, V, A in HSV mode), then press Enter."
                    VerticalContentAlignment="Center" />

                <ComboBox
                    Grid.Column="1"
                    Classes="below"
                    SelectedIndex="{Binding ModeIndex}"
                    ToolTip.Tip="How the color reads: as RGB or HSV values (and sliders), or as hex."
                    VerticalAlignment="Stretch">

                    <ComboBoxItem Content="RGB" />
                    <ComboBoxItem Content="HSV" />
                    <ComboBoxItem Content="Hex" />
                </ComboBox>

                <ToggleButton
                    Grid.Column="2"
                    Content="Eyedropper"
                    IsChecked="{Binding IsEyedropping}"
                    ToolTip.Tip="Takes the paint of the next asset you click as the brush's (Esc cancels).&#x0a;(Bound to a tap of Ctrl)" />

                <DropDownButton Grid.Column="3" ToolTip.Tip="What the brush applies (and the eyedropper takes).">
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" VerticalOffset="2">
                            <!-- 5 matches SimpleTheme's context menu padding, so the flyout lines up with menus -->
                            <StackPanel Spacing="5">
                                <CheckBox
                                    Content="Color"
                                    IsChecked="{Binding IsColorApplied}"
                                    ToolTip.Tip="Whether painting applies the brush's color." />

                                <CheckBox
                                    Content="Material"
                                    IsChecked="{Binding IsMaterialApplied}"
                                    ToolTip.Tip="Whether painting applies the brush's material." />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <!-- The splitter keeps each side wide enough for its controls -->
            <Grid Grid.Row="1" ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="192" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="128" />
                </Grid.ColumnDefinitions>

                <Grid
                    Classes.dimmed="{Binding !IsColorApplied}"
                    RowDefinitions="*,Auto,Auto,Auto,Auto,*"
                    RowSpacing="2">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="2" MinHeight="64">
                        <!-- A strip shaped like the brightness slider across from it; the theme fixes its height. Dark and
                             light rings set it off from any background -->
                        <Border
                            BorderBrush="Black" BorderThickness="{StaticResource BorderThickness}"
                            CornerRadius="13">

                            <Border
                                BorderBrush="White" BorderThickness="{StaticResource BorderThickness}"
                                CornerRadius="11.5">

                                <cp:ColorPreviewer
                                    HsvColor="{Binding HsvColor}"
                                    ToolTip.Tip="The brush's color."
                                    IsAccentColorsVisible="False"
                                    Width="20"
                                    Height="NaN"
                                    CornerRadius="10" />
                            </Border>
                        </Border>

                        <!-- Draws itself as the largest square that fits, centered -->
                        <cp:ColorSpectrum
                            Grid.Column="1"
                            HsvColor="{Binding HsvColor}"
                            ToolTip.Tip="Drag to pick the hue (across) and saturation (down)."
                            Components="HueSaturation" />

                        <cp:ColorSlider
                            Grid.Column="2"
                            HsvColor="{Binding HsvColor}"
                            ToolTip.Tip="Brightness."
                            ColorComponent="Component3"
                            ColorModel="Hsva"
                            Orientation="Vertical" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="2">
                        <cp:ColorSlider
                            Classes="component"
                            HsvColor="{Binding HsvColor}"
                            ColorComponent="Component1"
                            ColorModel="{Binding SliderModel}" />

                        <NumericUpDown
                            Grid.Column="1"
                            Classes="component"
                            Value="{Binding Component1, UpdateSourceTrigger=LostFocus}"
                            Maximum="{Binding ComponentMaximum1}" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="2">
                        <cp:ColorSlider
                            Classes="component"
                            HsvColor="{Binding HsvColor}"
                            ColorComponent="Component2"
                            ColorModel="{Binding SliderModel}" />

                        <NumericUpDown
                            Grid.Column="1"
                            Classes="component"
                            Value="{Binding Component2, UpdateSourceTrigger=LostFocus}"
                            Maximum="{Binding ComponentMaximum23}" />
                    </Grid>

                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="2">
                        <cp:ColorSlider
                            Classes="component"
                            HsvColor="{Binding HsvColor}"
                            ColorComponent="Component3"
                            ColorModel="{Binding SliderModel}" />

                        <NumericUpDown
                            Grid.Column="1"
                            Classes="component"
                            Value="{Binding Component3, UpdateSourceTrigger=LostFocus}"
                            Maximum="{Binding ComponentMaximum23}" />
                    </Grid>

                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="2">
                        <cp:ColorSlider
                            Classes="component"
                            HsvColor="{Binding HsvColor}"
                            ToolTip.Tip="Alpha (opacity), for assets that can be see-through."
                            ColorComponent="Alpha"
                            ColorModel="{Binding SliderModel}"
                            IsAlphaVisible="True" />

                        <NumericUpDown
                            Grid.Column="1"
                            Classes="component"
                            Value="{Binding Alpha, UpdateSourceTrigger=LostFocus}"
                            Maximum="255" />
                    </Grid>

                    <TabControl Grid.Row="5" Padding="0" MinHeight="64">
                        <TabItem Header="Swatches" ToolTip.Tip="The named web colors.">
                            <ScrollViewer Name="NamedScroll">
                                <c:SwatchGrid
                                    Name="NamedSwatches"
                                    Items="{x:Static vm:PaintPaletteViewModel.NamedSwatches}"
                                    Command="{Binding ApplySwatchCommand}"
                                    Cursor="Hand"
                                    BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                    HoverBrush="{DynamicResource ThemeForegroundBrush}"
                                    Margin="1" />
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Recent" ToolTip.Tip="The colors you painted last, newest first.">
                            <ScrollViewer Name="RecentScroll">
                                <c:SwatchGrid
                                    Name="RecentSwatches"
                                    Items="{Binding RecentSwatches}"
                                    Command="{Binding ApplySwatchCommand}"
                                    Cursor="Hand"
                                    BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                    HoverBrush="{DynamicResource ThemeForegroundBrush}"
                                    Margin="1" />
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <GridSplitter
                    Grid.Column="1"
                    ResizeDirection="Columns"
                    Background="{StaticResource PrimaryBrush}" />

                <!-- Docked, so the hidden stats take no gap -->
                <DockPanel
                    Grid.Column="2"
                    Classes.dimmed="{Binding !IsMaterialApplied}"
                    VerticalSpacing="2">

                    <DockPanel DockPanel.Dock="Top" HorizontalSpacing="2">
                        <PathIcon
                            DockPanel.Dock="Right"
                            Data="{StaticResource TipIcon}"
                            ToolTip.Tip="Default isn't a material of its own: it keeps whatever material each asset was made with, such as the wheel's rubber."
                            Background="Transparent"
                            Width="16" Height="16" />

                        <TextBox
                            Text="{Binding MaterialQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Filter by Name or ID&#x2026;"
                            GotFocus="OnMaterialFilterGotFocus"
                            ToolTip.Tip="Filters the materials below by name or internal ID." />
                    </DockPanel>

                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Text="{Binding CurrentMaterial.Stats, FallbackValue={x:Null}}"
                        FontSize="12"
                        IsVisible="{Binding CurrentMaterial.Stats, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />

                    <!-- Scrolled outside the list, so its scroll bar can keep a gap; its items wrap at its width -->
                    <ScrollViewer Name="MaterialsScroll">
                        <ListBox
                            Name="Materials"
                            ItemsSource="{Binding VisibleMaterials}"
                            SelectedItem="{Binding SelectedMaterial}"
                            SelectionMode="Single"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:MaterialItem">
                                    <StackPanel ToolTip.Tip="{Binding Stats}" Width="72" Spacing="2">
                                        <Image Source="{Binding Preview}" Width="56" Height="56" />

                                        <c:ScrollingTextBlock
                                            Text="{Binding Name}"
                                            HorizontalAlignment="Center"
                                            TextElement.FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>

</UserControl>
