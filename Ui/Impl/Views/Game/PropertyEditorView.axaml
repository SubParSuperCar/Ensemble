<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EnsembleRoot.Ui.ViewModels"
    xmlns:c="using:EnsembleRoot.Ui.Controls"
    xmlns:gd="using:EnsembleRoot.GdCore.Assets"
    mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="192"
    x:Class="EnsembleRoot.Ui.Views.PropertyEditorView"
    x:DataType="vm:PropertyEditorViewModel">

    <Border Background="{DynamicResource TranslucentBackgroundBrush}" Padding="2">
        <Grid RowDefinitions="Auto,*" RowSpacing="2">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                <TextBox
                    Text="{Binding FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Filter Properties&#x2026;"
                    GotFocus="OnFilterBoxGotFocus"
                    ToolTip.Tip="Filters the property list below by name." />

                <Button
                    Name="CopyButton"
                    Grid.Column="1"
                    Content="Copy"
                    Command="{Binding CopyCommand}"
                    ToolTip.Tip="Copies the properties the selected assets agree on. (Bound to Ctrl+C)"
                    IsEnabled="{Binding IsCopyEnabled}" />

                <Button
                    Name="PasteButton"
                    Grid.Column="2"
                    Content="Paste"
                    Command="{Binding PasteCommand}"
                    ToolTip.Tip="Pastes the copied properties onto the selected assets that have them. (Bound to Ctrl+V)"
                    IsEnabled="{Binding IsPasteEnabled}" />

                <DropDownButton Grid.Column="3" ToolTip.Tip="Property Editor options.">
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" VerticalOffset="2">
                            <CheckBox
                                Content="Show Internal"
                                IsChecked="{Binding IsInternalShown}"
                                ToolTip.Tip="Also lists the engine's own properties, such as an asset's color and material." />
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <ScrollViewer Name="ItemsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl
                    Name="Items"
                    ItemsSource="{Binding VisibleItems}"
                    SizeChanged="OnItemsSizeChanged"
                    Grid.IsSharedSizeScope="True">

                    <ItemsControl.Resources>
                        <x:Double x:Key="NameMaxWidth">160</x:Double>
                    </ItemsControl.Resources>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- Each property type gets its own editor -->
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:TogglePropertyItem">
                            <!-- Filled with empty content, so the whole row is a target rather than only the box -->
                            <CheckBox
                                IsChecked="{Binding Value}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

                                <Border Background="Transparent" />
                            </CheckBox>
                        </DataTemplate>

                        <DataTemplate DataType="vm:IntegerPropertyItem">
                            <NumericUpDown
                                Value="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                PlaceholderText="{Binding Placeholder}"
                                Minimum="-9223372036854775808" Maximum="9223372036854775807"
                                Increment="1"
                                FormatString="0" ParsingNumberStyle="Integer" />
                        </DataTemplate>

                        <!-- Never focused, and it drops focus elsewhere, so the key being bound goes nowhere else -->
                        <DataTemplate DataType="vm:KeyPropertyItem">
                            <Button
                                Content="{Binding Text}"
                                Command="{Binding ToggleListeningCommand}"
                                Click="OnKeyButtonClick"
                                ToolTip.Tip="Click, then press the key to bind. Escape or another click cancels."
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Focusable="False" />
                        </DataTemplate>

                        <DataTemplate DataType="vm:DecimalPropertyItem">
                            <NumericUpDown
                                Value="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                PlaceholderText="{Binding Placeholder}"
                                Increment="0.001"
                                ShowButtonSpinner="False" />
                        </DataTemplate>

                        <DataTemplate DataType="vm:TextPropertyItem">
                            <TextBox
                                Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                PlaceholderText="{Binding Placeholder}"
                                MaxLength="{x:Static gd:GdProperties.MaxStringLength}" />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PropertyItem">
                            <!-- One shared row height, so every type's row is as tall as the tallest editor's -->
                            <Grid Background="{DynamicResource TranslucentBackgroundBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="Row" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <c:ScrollingTextBlock
                                    Text="{Binding DisplayName}"
                                    ToolTip.Tip="{Binding Description}"
                                    VerticalAlignment="Center"
                                    MaxWidth="{DynamicResource NameMaxWidth}"
                                    Margin="4,0,2,0" />

                                <!-- Hidden ones take no room, nor spacing, leaving it all to the editor -->
                                <DockPanel Grid.Column="1" HorizontalSpacing="2">
                                    <Button
                                        Classes="square"
                                        DockPanel.Dock="Right"
                                        Command="{Binding ResetCommand}"
                                        ToolTip.Tip="Resets this property to its default on the selected assets."
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Padding="2,0"
                                        Focusable="False"
                                        IsVisible="{Binding CanReset}">

                                        <PathIcon Data="{StaticResource ResetIcon}" Width="16" Height="16" />
                                    </Button>

                                    <PathIcon
                                        DockPanel.Dock="Right"
                                        Data="{StaticResource WarningIcon}"
                                        ToolTip.Tip="The selected assets differ in this property. Setting it sets it on all of them."
                                        Background="Transparent"
                                        VerticalAlignment="Center"
                                        Width="16" Height="16"
                                        IsVisible="{Binding IsMixed}" />

                                    <ContentControl Content="{Binding}" />
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Stretched, as a centered block may be arranged narrower than it wrapped at and clip its last line -->
            <TextBlock
                Grid.Row="1"
                Text="{Binding Notice}"
                VerticalAlignment="Center"
                Margin="4,0"
                TextAlignment="Center" TextWrapping="Wrap"
                IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
    </Border>

</UserControl>
