<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EnsembleRoot.Ui.ViewModels"
    xmlns:t="using:EnsembleRoot.Common.Text"
    mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="256"
    x:Class="EnsembleRoot.Ui.Views.TextChatView"
    x:DataType="vm:TextChatViewModel">

    <Border Padding="2">
        <Border.Background>
            <SolidColorBrush
                Color="{DynamicResource ThemeBackgroundColor}"
                Opacity="0.75" />
        </Border.Background>

        <Grid RowDefinitions="*,Auto" RowSpacing="2">
            <ScrollViewer Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
                <!-- Filled in code-behind, since inlines can't be bound -->
                <SelectableTextBlock Name="ChatLog" FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                <TextBox
                    Name="MessageBox"
                    Text="{Binding Message}"
                    PlaceholderText="Press '/' to chat&#x2026;"
                    KeyDown="OnMessageBoxKeyDown"
                    ToolTip.Tip="Type a message, then press Enter to send it. (Esc to stop typing)"
                    VerticalContentAlignment="Center"
                    MaxLength="{x:Static t:ChatText.MaxLength}" />

                <Border
                    Grid.Column="1"
                    BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="{StaticResource BorderThickness}">

                    <Button Command="{Binding SendCommand}" ToolTip.Tip="Sends your message. (Enter)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Send" />

                            <Path
                                VerticalAlignment="Center"
                                Data="M 0,0 L 16,6 L 0,12 L 4,6 Z"
                                Fill="{Binding $parent[Button].Foreground}" />
                        </StackPanel>
                    </Button>
                </Border>

                <DropDownButton Grid.Column="2" ToolTip.Tip="Chat options.">
                    <DropDownButton.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight" VerticalOffset="-2">
                            <!-- 5 matches SimpleTheme's context menu padding, so the flyout lines up with menus -->
                            <StackPanel Spacing="5">
                                <CheckBox
                                    Content="Profanity Filter"
                                    IsChecked="{Binding IsProfanityFilterEnabled}"
                                    ToolTip.Tip="Masks profanity in chat and replaces inappropriate player names. (Host only)"
                                    IsVisible="{Binding IsHost}" />

                                <CheckBox
                                    Content="Log to File"
                                    IsChecked="{Binding IsFileLoggingEnabled}"
                                    ToolTip.Tip="Saves each session's chat to a text file in the user data folder." />

                                <CheckBox
                                    Content="Read Aloud"
                                    IsChecked="{Binding IsTtsEnabled}"
                                    ToolTip.Tip="Reads new messages aloud with text-to-speech." />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
        </Grid>
    </Border>

</UserControl>
