<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EnsembleRoot.Ui.ViewModels"
    xmlns:t="using:EnsembleRoot.Common.Text"
    xmlns:ae="using:AvaloniaEdit"
    xmlns:aee="using:AvaloniaEdit.Editing"
    mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="256"
    x:Class="EnsembleRoot.Ui.Views.TextChatView"
    x:DataType="vm:TextChatViewModel">

    <UserControl.Styles>
        <Style Selector="aee|TextArea">
            <Setter Property="SelectionBorder" Value="{x:Null}" />
            <Setter Property="SelectionCornerRadius" Value="0" />
        </Style>
    </UserControl.Styles>

    <Border Padding="2">
        <Border.Background>
            <SolidColorBrush
                Color="{DynamicResource ThemeBackgroundColor}"
                Opacity="0.75" />
        </Border.Background>

        <Grid RowDefinitions="*,Auto" RowSpacing="2">
            <!-- Filled in code-behind, which styles the names. Shows the lines in view alone, as laying out the whole
                 chat again for each message stalled frames -->
            <ae:TextEditor
                Name="ChatLog"
                TemplateApplied="OnChatLogTemplateApplied"
                Background="Transparent"
                FontSize="12"
                IsReadOnly="True"
                WordWrap="True">

                <ae:TextEditor.Options>
                    <ae:TextEditorOptions AllowScrollBelowDocument="False" />
                </ae:TextEditor.Options>
            </ae:TextEditor>

            <TextBlock
                Grid.Row="0"
                Text="Break the ice!"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                FontStyle="Italic"
                IsVisible="{Binding !Lines.Count}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                <TextBox
                    Name="MessageBox"
                    Text="{Binding Message}"
                    PlaceholderText="Press '/' to chat&#x2026;"
                    KeyDown="OnMessageBoxKeyDown"
                    ToolTip.Tip="Type a message, then press Enter to send it.&#x0a;(Esc to stop typing)"
                    VerticalContentAlignment="Center"
                    MaxLength="{x:Static t:ChatText.MaxLength}" />

                <Border
                    Grid.Column="1"
                    BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="{StaticResource BorderThickness}">

                    <Button Command="{Binding SendCommand}" ToolTip.Tip="Sends your message. (Enter)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Send" />

                            <PathIcon Data="{StaticResource SendIcon}" Width="16" Height="16" />
                        </StackPanel>
                    </Button>
                </Border>

                <DropDownButton Grid.Column="2" ToolTip.Tip="Chat options.">
                    <DropDownButton.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight" VerticalOffset="-2">
                            <!-- 5 matches SimpleTheme's context menu padding, so the flyout lines up with menus -->
                            <StackPanel Spacing="5">
                                <CheckBox
                                    Content="Profanity Filter"
                                    IsChecked="{Binding IsProfanityFilterEnabled}"
                                    ToolTip.Tip="Masks profanity in chat and replaces inappropriate&#x0a;player names. (Host only)"
                                    IsVisible="{Binding IsHost}" />

                                <CheckBox
                                    Content="Log to File"
                                    IsChecked="{Binding IsFileLoggingEnabled}"
                                    ToolTip.Tip="Saves each session's chat to a text file in the user&#x0a;data folder." />

                                <CheckBox
                                    Content="Read Aloud"
                                    IsChecked="{Binding IsTtsEnabled}"
                                    ToolTip.Tip="Reads new messages aloud with text-to-speech." />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
        </Grid>
    </Border>

</UserControl>
