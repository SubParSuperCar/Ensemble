<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    x:Class="EnsembleRoot.Ui.Impl.Views.ToolBarView"
    x:DataType="vm:ToolBarViewModel"
    Margin="0,4"
    FontSize="20" FontWeight="ExtraLight">

    <UserControl.Styles>
        <Style Selector="Button, ToggleButton">
            <Setter Property="LetterSpacing" Value="-1" />
        </Style>
    </UserControl.Styles>

    <StackPanel HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
        <Grid ColumnSpacing="4" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Place" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Delete" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Edit" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Paint" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Move" />
                <!-- <ColumnDefinition Width="Auto" SharedSizeGroup="Inspect" /> -->
                <ColumnDefinition Width="Auto" SharedSizeGroup="History" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Options" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="1"
                BorderBrush="{StaticResource DangerBrush}" BorderThickness="{StaticResource BorderThickness}"
                Margin="0,0,0,4"
                IsVisible="{Binding IsClearAllVisible}">

                <Button
                    Content="&#x26A0; Clear All (2x) &#x26A0;"
                    DoubleTapped="OnClearAllDoubleTapped"
                    ToolTip.Tip="Removes every asset from your plot. (Double-click)&#x0a;&#x26A0; WARNING: THIS ACTION CANNOT BE UNDONE! &#x26A0;"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding IsClearAllEnabled}" />
            </Border>
        </Grid>

        <Border
            Background="{DynamicResource TranslucentBackgroundBrush}"
            CornerRadius="6"
            Padding="4">

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Place" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Delete" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Edit" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Paint" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Move" />
                    <!-- <ColumnDefinition Width="Auto" SharedSizeGroup="Inspect" /> -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="History" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Options" />
                </Grid.ColumnDefinitions>

                <Border
                    BorderBrush="{x:Static vm:ToolBarViewModel.ConstructBrush}"
                    BorderThickness="{StaticResource BorderThickness}">

                    <ToggleButton
                        Content="Place (1)"
                        Command="{Binding ToggleConstructToolCommand}"
                        IsChecked="{Binding IsConstructToolEnabled}"
                        ToolTip.Tip="Toggles the placement (construct/ctor) tool. (Bound to 1 / One)" />
                </Border>

                <Border
                    Grid.Column="1"
                    BorderBrush="{x:Static vm:ToolBarViewModel.DestructBrush}"
                    BorderThickness="{StaticResource BorderThickness}">

                    <ToggleButton
                        Content="Delete (2)"
                        Command="{Binding ToggleDestructToolCommand}"
                        IsChecked="{Binding IsDestructToolEnabled}"
                        ToolTip.Tip="Toggles the deletion (destruct) tool. (Bound to 2 / Two)&#x0a;&#x0a;Click an asset to delete it, or Shift-click to (de)select it.&#x0a;Ctrl-drag to box-select (hold Shift to toggle instead); Esc cancels.&#x0a;Click a selected asset to delete the whole selection." />
                </Border>

                <Border
                    Grid.Column="2"
                    BorderBrush="{x:Static vm:ToolBarViewModel.PropertyBrush}"
                    BorderThickness="{StaticResource BorderThickness}">

                    <ToggleButton
                        Content="Edit (3)"
                        Command="{Binding TogglePropertyToolCommand}"
                        IsChecked="{Binding IsPropertyToolEnabled}"
                        ToolTip.Tip="Toggles the editing (property) tool. (Bound to 3 / Three)&#x0a;&#x0a;Click an asset to select it, or Shift-click to (de)select it.&#x0a;Ctrl-drag to box-select (hold Shift to toggle instead); Esc cancels.&#x0a;Ctrl+C copies the selection's shared properties; Ctrl+V pastes them onto the selection." />
                </Border>

                <Border Grid.Column="3" BorderBrush="#E050E0" BorderThickness="{StaticResource BorderThickness}">
                    <ToggleButton
                        Content="Paint (4)"
                        ToolTip.Tip="Toggles the painting (material) tool. (Bound to 4 / Four)"
                        IsEnabled="False" />
                </Border>

                <Border Grid.Column="4" BorderBrush="#E0C000" BorderThickness="{StaticResource BorderThickness}">
                    <ToggleButton
                        Content="Move (5)"
                        ToolTip.Tip="Toggles the moving (translate) tool. (Bound to 5 / Five)"
                        IsEnabled="False" />
                </Border>

                <!--<Border Grid.Column="5" BorderBrush="#FF8000" BorderThickness="{StaticResource BorderThickness}">
                    <ToggleButton
                        Content="Inspect (6)"
                        ToolTip.Tip="Toggles the inspection (inspect) tool. (Bound to 6 / Six)"
                        IsEnabled="False" />
                </Border>-->

                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                    <Button
                        Content="&lt;-"
                        Command="{Binding UndoCommand}"
                        ToolTip.Tip="Undoes your last tool edit on this plot. (Bound to Ctrl+Z)"
                        IsEnabled="{Binding IsUndoEnabled}" />

                    <Button
                        Content="-&gt;"
                        Command="{Binding RedoCommand}"
                        ToolTip.Tip="Redoes your last undone tool edit on this plot. (Bound to Ctrl+X)"
                        IsEnabled="{Binding IsRedoEnabled}" />
                </StackPanel>

                <StackPanel Grid.Column="6" Spacing="4" VerticalAlignment="Center" TextElement.FontSize="12">
                    <CheckBox
                        Content="Mut.Ex."
                        IsChecked="{Binding IsMutexEnforced}"
                        ToolTip.Tip="Mutual Exclusion: Toggles whether only one tool can be enabled at a time.&#x0a;Disables all other tools when you enable one." />

                    <CheckBox
                        Content="Restore"
                        IsChecked="{Binding IsRestoreOnDespawnEnabled}"
                        ToolTip.Tip="Toggles whether the tools that spawning your plot disabled are enabled again when it despawns." />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>

</UserControl>
