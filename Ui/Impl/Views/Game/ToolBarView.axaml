    FontSize="20" FontWeight="ExtraLight">
    <!--x:Class="Root.Ui.Impl.Views.ToolBarView"
    x:DataType="vm:ToolBarViewModel"-->

    <Border
        Background="{DynamicResource TranslucentBackgroundBrush}"
        Padding="4"
        CornerRadius="6">

        <!--<StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="ToolBar">
            <Border BorderBrush="DodgerBlue" BorderThickness="1">
                <ToggleButton
                    Content="Place Tool (1)"
                    Command="{Binding TogglePlaceToolCommand}"
                    IsChecked="{Binding IsPlaceToolEnabled}"
                    ToolTip.Tip="Toggles the place tool. (Bound to One)" />
            </Border>

            <Border BorderBrush="Red" BorderThickness="1">
                <ToggleButton
                    Content="Delete Tool (2)"
                    Command="{Binding ToggleDeleteToolCommand}"
