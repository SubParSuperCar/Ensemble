<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Root.Ui.Impl.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="Root.Ui.Impl.Views.GameView"
    x:DataType="viewModels:GameViewModel">

    <Grid>
        <ContentControl Content="{Binding Clock}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" />

        <ContentControl Content="{Binding PlayerList}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        MaxWidth="512" MaxHeight="256" />

        <ContentControl Content="{Binding PlotSelector}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        MinWidth="384" MaxWidth="512" MaxHeight="256" />
    </Grid>

</UserControl>
