<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Root.Ui.Impl.ViewModels"
    xmlns:li="using:LoadingIndicators.Avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="Root.Ui.Impl.Views.MainView"
    x:DataType="vm:MainViewModel"
    TextOptions.TextRenderingMode="Antialias">

    <Grid>
        <TransitioningContentControl Content="{Binding Main}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="{StaticResource TransitionDuration}" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <ContentControl
            Content="{Binding Stats}"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="4,36,0,0"
            IsHitTestVisible="False" />

        <Grid ColumnDefinitions="1*,4*,1*" RowDefinitions="1*,4*,1*">
            <TransitioningContentControl
                Grid.Row="1" Grid.Column="1"
                Content="{Binding Console}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                ClipToBounds="False">

                <TransitioningContentControl.Effect>
                    <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="24" />
                </TransitioningContentControl.Effect>

                <TransitioningContentControl.PageTransition>
                    <CompositePageTransition>
                        <CrossFade Duration="{StaticResource TransitionDuration}" />
                        <Rotate3DTransition Duration="{StaticResource TransitionDuration}" Orientation="Vertical" />
                    </CompositePageTransition>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>

        <Border Effect="{DynamicResource StrokeEffect}">
            <li:LoadingIndicator
                Mode="ArcsRing"
                Foreground="GreenYellow"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Width="64" Height="64"
                SpeedRatio="2" />
        </Border>

        <StackPanel
            Orientation="Horizontal" Spacing="4"
            HorizontalAlignment="Right" VerticalAlignment="Top">

            <ToggleButton
                Content="Dev-Console (` / F9)"
                IsChecked="{Binding IsConsoleVisible, Mode=TwoWay}"
                ToolTip.Tip="Toggles the console UI. (Bound to ` and F9)"
                Background="{DynamicResource TranslucentBackgroundBrush}" />

            <Button
                Content="Sys-Terminal (PTY, F8)"
                Command="{Binding OpenTerminalCommand}"
                ToolTip.Tip="Opens a new pseudo-terminal (PTY) window. (Bound to F8)&#x0a;On Windows, Command Prompt (cmd) is used.&#x0a;On other OSes, Bash is used.&#x0a;&#x0a;&#x26A0; WARNING: &#x26A0;&#x0a;Be careful what you run; don't run anything&#x0a;someone sends you without reviewing it first.&#x0a;The consequences could be devastating.&#x0a;&#x0a;Note:&#x0a;The terminal inherits the same privilege level&#x0a;as the main Ensemble process."
                Background="{DynamicResource TranslucentBackgroundBrush}" />
        </StackPanel>

        <TextBlock
            Text="&quot;Ensemble&quot; (In-Dev. Build)&#x0a;By: @SubParSuperCar &amp; Contributors"
            Background="Black" Foreground="Red"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Padding="2"
            FontSize="14"
            IsHitTestVisible="False"
            TextOptions.TextRenderingMode="Alias" />
    </Grid>

</UserControl>
