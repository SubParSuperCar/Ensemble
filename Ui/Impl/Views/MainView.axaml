<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EnsembleRoot.Ui.ViewModels"
    xmlns:cm="using:EnsembleRoot.Common"
    xmlns:li="using:LoadingIndicators.Avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="EnsembleRoot.Ui.Views.MainView"
    x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="Border#WatermarkBackground">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{x:Static cm:Constants.AnimationDuration}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border#WatermarkBackground.dimmed">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Disabled while hidden, so a focused text box lets go of the game's input -->
        <Grid
            Classes="fade"
            Classes.shown="{Binding !IsPhotoMode}" Classes.hidden="{Binding IsPhotoMode}"
            IsEnabled="{Binding !IsPhotoMode}">

            <TransitioningContentControl Content="{Binding Main}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="{x:Static cm:Constants.AnimationDuration}" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <ContentControl
                Content="{Binding Clock}"
                HorizontalAlignment="Center" VerticalAlignment="Top" />

            <ContentControl
                Content="{Binding Stats}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="4,36,0,0"
                IsHitTestVisible="False" />

            <Grid ColumnDefinitions="1*,4*,1*" RowDefinitions="1*,4*,1*">
                <TransitioningContentControl
                    Grid.Row="1" Grid.Column="1"
                    Content="{Binding Console}"
                    ClipToBounds="False">

                    <TransitioningContentControl.PageTransition>
                        <CompositePageTransition>
                            <CrossFade Duration="{x:Static cm:Constants.AnimationDuration}" />
                            <Rotate3DTransition
                                Orientation="Vertical"
                                Duration="{x:Static cm:Constants.AnimationDuration}" />
                        </CompositePageTransition>
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Grid>

            <ContentControl
                Content="{Binding Toasts}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="512"
                Margin="0,36,0,0" />

            <Border Effect="{DynamicResource StrokeEffect}">
                <li:LoadingIndicator
                    Mode="ArcsRing"
                    Foreground="GreenYellow"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="64" Height="64"
                    SpeedRatio="2" />
            </Border>

            <StackPanel
                Orientation="Horizontal" Spacing="4"
                HorizontalAlignment="Right" VerticalAlignment="Top">

                <ToggleButton
                    Content="Dev-Console (` / F9)"
                    IsChecked="{Binding IsConsoleVisible, Mode=TwoWay}"
                    ToolTip.Tip="Toggles the console UI. (Bound to ` and F9)"
                    Background="{DynamicResource TranslucentBackgroundBrush}" />

                <Button
                    Content="Sys-Terminal (PTY, F8)"
                    Command="{Binding OpenTerminalCommand}"
                    ToolTip.Tip="Opens a new pseudo-terminal (PTY) window. (Bound to F8)&#x0a;On Windows, Command Prompt (cmd) is used.&#x0a;On other OSes, Bash is used.&#x0a;&#x0a;&#x26A0; WARNING: &#x26A0;&#x0a;Be careful what you run; don't run anything&#x0a;someone sends you without reviewing it first.&#x0a;The consequences could be devastating.&#x0a;&#x0a;Note:&#x0a;The terminal inherits the same privilege level&#x0a;as the main Ensemble process."
                    Background="{DynamicResource TranslucentBackgroundBrush}" />
            </StackPanel>

            <Panel HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Border Name="WatermarkBackground" Background="Black" />

                <TextBlock
                    Name="Watermark"
                    Foreground="Red"
                    Padding="2"
                    FontSize="11.5"
                    TextOptions.TextRenderingMode="Alias" />
            </Panel>
        </Grid>

        <TextBlock
            Classes="fade"
            Classes.shown="{Binding IsPhotoModeHintShown}"
            Text="Photo mode: press F1 to show the UI."
            Background="{DynamicResource TranslucentBackgroundBrush}"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,36,0,0"
            Padding="4,2"
            IsHitTestVisible="False" />
    </Grid>

</UserControl>
