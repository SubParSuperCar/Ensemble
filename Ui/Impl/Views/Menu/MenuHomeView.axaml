<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Root.Ui.Impl.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="Root.Ui.Impl.Views.MenuHomeView"
    x:DataType="vm:MenuHomeViewModel"
    TextOptions.TextRenderingMode="Antialias"
    FontSize="24" FontWeight="ExtraLight">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="1*,1*,1*,1*,1*">
        <StackPanel
            Grid.Row="1" Spacing="8"
            HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border
                Width="256" Height="256"
                CornerRadius="8" ClipToBounds="True">

                <Image
                    Source="{Binding Icon}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Stretch="UniformToFill">

                    <ToolTip.Tip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Ensemble's Icon (Made w/ Inkscape)" />
                                <Image Source="{Binding Icon}" Stretch="None" />
                            </StackPanel>
                        </ToolTip>
                    </ToolTip.Tip>
                </Image>
            </Border>

            <HyperlinkButton
                Content="Ensemble - GitHub Page&#x0a;github.com/SubParSuperCar/Ensemble"
                Command="{Binding OpenGitHubPageCommand}"
                ToolTip.Tip="Opens Ensemble's official GitHub repository page.&#x0a;Feel free to star it and/or contribute! :)" />
        </StackPanel>

        <StackPanel
            Grid.Row="3" Spacing="8"
            HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border
                BorderBrush="DodgerBlue" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">

                <Button
                    Content="Play (Esc)"
                    Command="{Binding StartSessionCommand}"
                    ToolTip.Tip="Starts a new [single player] session. (Bound to Escape)" />
            </Border>

            <StackPanel
                Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Center">

                <Button
                    Content="Doc-Files"
                    Command="{Binding GoToDocFileViewerCommand}"
                    ToolTip.Tip="Opens the documentation viewer, including README.md, licenses, etc." />

                <Button
                    Content="Settings"
                    ToolTip.Tip="Opens the settings menu."
                    IsEnabled="False" />
            </StackPanel>

            <Button
                Content="Web Browser"
                Command="{Binding GoToWebBrowserCommand}"
                ToolTip.Tip="Opens the web browser.&#x0a;Requires a compatible web rendering component.&#x0a;On Windows, WebView2 should already be installed.&#x0a;On Linux, you may need to install WebKitGTK or WPE WebKit." />

            <Border
                BorderBrush="Red" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">

                <Button
                    Content="Quit (2x)"
                    DoubleTapped="OnQuitButtonDoubleTapped"
                    ToolTip.Tip="Shuts down the game. (Double-click)" />
            </Border>
        </StackPanel>
    </Grid>

</UserControl>
