<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EnsembleRoot.Ui.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="EnsembleRoot.Ui.Views.MenuHomeView"
    x:DataType="vm:MenuHomeViewModel"
    FontSize="24" FontWeight="ExtraLight">

    <Grid>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <HyperlinkButton
                NavigateUri="{Binding GitHubPageUri}"
                ToolTip.Tip="Opens Ensemble's official GitHub repository page.&#x0a;Feel free to star it and/or contribute! :)">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon
                        Data="{StaticResource GitHubIcon}"
                        Width="20" Height="20"
                        Foreground="{DynamicResource ThemeForegroundBrush}" />

                    <TextBlock Text="GitHub" />
                </StackPanel>
            </HyperlinkButton>

            <HyperlinkButton
                NavigateUri="{Binding ItchPageUri}"
                ToolTip.Tip="Opens Ensemble's itch.io page.&#x0a;The itch app keeps your copy up to date.">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon
                        Data="{StaticResource ItchIcon}"
                        Width="20" Height="20"
                        Foreground="{DynamicResource ThemeForegroundBrush}" />

                    <TextBlock Text="itch.io" />
                </StackPanel>
            </HyperlinkButton>
        </StackPanel>

        <!-- Sized by their content, so the spaces between them are what shrinks, down to their margins -->
        <Grid RowDefinitions="2*,Auto,*,Auto,*,Auto,2*">
            <Border
                Grid.Row="1"
                Width="256" Height="256"
                CornerRadius="8" ClipToBounds="True">

                <Image
                    Source="{Binding Icon}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Stretch="UniformToFill">

                    <ToolTip.Tip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Ensemble's Icon (Made with Inkscape)" />
                                <Image Source="{Binding Icon}" Stretch="None" />
                            </StackPanel>
                        </ToolTip>
                    </ToolTip.Tip>
                </Image>
            </Border>

            <Border
                Grid.Row="3"
                BorderBrush="{StaticResource DangerBrush}" BorderThickness="{StaticResource BorderThickness}"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">

                <TextBlock
                    Text="{Binding Notice}"
                    ToolTip.Tip="The reason your last session ended."
                    Background="{DynamicResource TranslucentBackgroundBrush}"
                    Padding="4"
                    FontSize="20"
                    TextWrapping="Wrap" />
            </Border>

            <StackPanel
                Grid.Row="5"
                Spacing="8"
                HorizontalAlignment="Center"
                Margin="0,8,0,0">

                <Border Classes="primary">
                    <Button
                        Content="Play (Esc)"
                        Command="{Binding GoToSessionCommand}"
                        ToolTip.Tip="Opens the session menu.&#x0a;Escape skips it and starts a single-player session." />
                </Border>

                <StackPanel
                    Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center">

                    <Button
                        Content="Doc-Files"
                        Command="{Binding GoToDocFileViewerCommand}"
                        ToolTip.Tip="Opens the documentation viewer, including README.md, licenses, etc." />

                    <Button
                        Content="Settings"
                        ToolTip.Tip="Opens the settings menu."
                        IsEnabled="False" />
                </StackPanel>

                <Button
                    Content="Web Browser"
                    Command="{Binding GoToWebBrowserCommand}"
                    ToolTip.Tip="Opens the web browser.&#x0a;It currently needs Linux and WPE WebKit 2.52 or older (install it via your package manager)." />

                <Border Classes="danger">
                    <Button
                        Content="Quit (2x)"
                        DoubleTapped="OnQuitButtonDoubleTapped"
                        ToolTip.Tip="Shuts down the game. (Double-click)" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
