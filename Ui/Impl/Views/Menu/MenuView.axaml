<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    xmlns:g="clr-namespace:EnsembleRoot.Globals"
    x:Class="EnsembleRoot.Ui.Impl.Views.MenuView"
    x:DataType="vm:MenuViewModel">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Panel.Background>
            <SolidColorBrush
                Color="{DynamicResource ThemeBackgroundColor}"
                Opacity="0.8125" />
        </Panel.Background>

        <TransitioningContentControl Content="{Binding Navigator.Current}" ClipToBounds="False">
            <TransitioningContentControl.PageTransition>
                <CompositePageTransition>
                    <CrossFade
                        Duration="{x:Static g:Constants.AnimationDuration}"
                        FadeInEasing="QuadraticEaseOut" FadeOutEasing="QuadraticEaseInOut" />

                    <PageSlide
                        Duration="{x:Static g:Constants.AnimationDuration}"
                        SlideInEasing="QuadraticEaseOut" SlideOutEasing="QuadraticEaseInOut" />
                </CompositePageTransition>
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </Panel>

</UserControl>
