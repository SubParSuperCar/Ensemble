<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    x:Class="EnsembleRoot.Ui.Impl.Views.MenuWebBrowserView"
    x:DataType="vm:MenuWebBrowserViewModel"
    TextOptions.TextRenderingMode="Antialias">

    <Grid>
        <ContentControl Content="{Binding Content}" />

        <Button
            Content="&lt;- Back"
            Command="{Binding GoBackCommand}"
            ToolTip.Tip="Goes back. (Bound to Backspace)"
            Background="{DynamicResource TranslucentBackgroundBrush}"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Margin="4"
            FontSize="24" />
    </Grid>

</UserControl>
