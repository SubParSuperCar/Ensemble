<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Root.Ui.Impl.ViewModels"
    x:Class="Root.Ui.Impl.Views.MenuWebBrowserView"
    x:DataType="vm:MenuWebBrowserViewModel">

    <Grid>
        <ContentControl Content="{Binding Content}" />

        <Button
            Content="&lt;- Back"
            Command="{Binding GoBackCommand}"
            ToolTip.Tip="Go back (Bound to Backspace)"
            Background="{DynamicResource TranslucentBackgroundBrush}"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="4"
            FontSize="24" />
    </Grid>

</UserControl>
