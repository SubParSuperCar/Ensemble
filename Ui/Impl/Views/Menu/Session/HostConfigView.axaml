<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="EnsembleRoot.Ui.Impl.Views.HostConfigView"
    x:DataType="vm:HostConfigViewModel"
    TextOptions.TextRenderingMode="Antialias"
    FontSize="24" FontWeight="ExtraLight">

    <StackPanel
        Spacing="8"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        MaxWidth="384">

        <TextBlock Text="Multi-Player Host Config:" />

        <StackPanel>
            <TextBlock Text="Port Number (1024&#x2013;65,535):" FontSize="16" />

            <NumericUpDown
                Value="{Binding Port}"
                PlaceholderText="&lt;Default&gt;"
                ToolTip.Tip="The UDP port to listen on. Clients need it to join.&#x0a;Leave empty for the default port."
                Minimum="1024" Maximum="65535"
                Increment="1"
                ShowButtonSpinner="False" />
        </StackPanel>

        <CheckBox
            Content="Auto Forward Port (UPnP)"
            IsChecked="{Binding IsUpnpEnabled}"
            ToolTip.Tip="Asks your router to forward the port so players outside your network can join. Remembered for next time.&#x0a;Uncheck if you forward the port manually, play over LAN, or prefer not to change router settings."
            FontSize="20" />

        <StackPanel>
            <TextBlock Text="Password (Optional):" FontSize="16" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox
                    Name="PasswordBox"
                    Text="{Binding Password}"
                    PlaceholderText="&lt;Not Enforced&gt;"
                    ToolTip.Tip="The password joining players must enter.&#x0a;Leave empty to let anyone join."
                    PasswordChar="*" />

                <CheckBox
                    Grid.Column="1"
                    Content="Show"
                    IsChecked="{Binding #PasswordBox.RevealPassword}"
                    ToolTip.Tip="Toggles whether the password is revealed."
                    FontSize="20" />
            </Grid>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Max Clients (1&#x2013;4,095):" FontSize="16" />

            <NumericUpDown
                Value="{Binding MaxClients}"
                PlaceholderText="&lt;Unlimited&gt;"
                ToolTip.Tip="The most players that can be connected at once, excluding you.&#x0a;Leave empty for no limit."
                Minimum="1" Maximum="4095"
                Increment="1" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Display Name (Alphanumeric, &#x2264;24):" FontSize="16" />

            <TextBox
                Text="{Binding DisplayName}"
                PlaceholderText="&lt;Short GUID&gt;"
                ToolTip.Tip="The name shown to other players. Remembered for next time.&#x0a;Leave empty to derive one from your server-assigned player ID."
                MaxLength="24" />
        </StackPanel>

        <TextBlock
            Text="{Binding Status}"
            FontSize="16"
            TextWrapping="Wrap"
            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button
                Content="&lt;- Back"
                Command="{Binding GoBackCommand}"
                ToolTip.Tip="Goes back. (Bound to Backspace)" />

            <Border Grid.Column="1" Classes="primary">
                <Button
                    Content="Host!"
                    Command="{Binding HostCommand}"
                    ToolTip.Tip="Starts hosting a new multi-player session." />
            </Border>
        </Grid>
    </StackPanel>

</UserControl>
