<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    x:Class="EnsembleRoot.Ui.Impl.Views.HostConfigView"
    x:DataType="vm:HostConfigViewModel"
    FontSize="24" FontWeight="ExtraLight">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" MaxWidth="384">
        <TextBlock Text="Multi-Player Host Config:" />

        <StackPanel>
            <TextBlock Text="Port Number (1024&#x2014;49,151):" FontSize="16" />
            <NumericUpDown
                Value="{Binding Port}"
                PlaceholderText="&lt;Auto&gt;"
                Minimum="1024" Maximum="49151" Increment="1"
                ShowButtonSpinner="False" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Password (Optional):" FontSize="16" />

            <Grid ColumnDefinitions="*,4,Auto">
                <TextBox
                    Name="PasswordBox"
                    Text="{Binding Password}"
                    PlaceholderText="&lt;Not Enforced&gt;"
                    PasswordChar="*" />

                <CheckBox
                    Grid.Column="2"
                    Content="Show"
                    IsChecked="{Binding #PasswordBox.RevealPassword}"
                    FontSize="20" />
            </Grid>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Display Name (Alphanumeric, &#x2264;24):" FontSize="16" />
            <TextBox Text="{Binding DisplayName}" PlaceholderText="&lt;Short GUID&gt;" MaxLength="24" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Max Clients (&#x2265;1):" FontSize="16" />
            <NumericUpDown
                Value="{Binding MaxClients}"
                PlaceholderText="&lt;Unlimited&gt;"
                Minimum="1" Increment="1" />
        </StackPanel>

        <TextBlock
            Text="{Binding Status}"
            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            FontSize="16"
            TextWrapping="Wrap" />

        <Grid ColumnDefinitions="*,4,*">
            <Button Content="&lt;- Back" Command="{Binding GoBackCommand}" />
            <Button Grid.Column="2" Content="Host!" Command="{Binding HostCommand}" />
        </Grid>
    </StackPanel>

</UserControl>
