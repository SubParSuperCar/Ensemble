<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="EnsembleRoot.Ui.Impl.Views.SessionModeSelectorView"
    x:DataType="vm:SessionModeSelectorViewModel"
    TextOptions.TextRenderingMode="Antialias"
    FontSize="24" FontWeight="ExtraLight">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="Session Mode:" />

        <Button
            Content="Single Player (Offline)"
            Command="{Binding GoToSinglePlayerCommand}"
            ToolTip.Tip="Configures a local session only you can play in." />

        <Button
            Content="Multi-Player (Online)"
            Command="{Binding GoToMultiPlayerCommand}"
            ToolTip.Tip="Configures a networked session others can join." />

        <Button
            Content="&lt;- Back"
            Command="{Binding GoBackCommand}"
            ToolTip.Tip="Goes back. (Bound to Backspace)" />
    </StackPanel>

</UserControl>
