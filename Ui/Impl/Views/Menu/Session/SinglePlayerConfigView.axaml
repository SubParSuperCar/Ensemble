<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    x:Class="EnsembleRoot.Ui.Impl.Views.SinglePlayerConfigView"
    x:DataType="vm:SinglePlayerConfigViewModel"
    FontSize="24" FontWeight="ExtraLight">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" MaxWidth="384">
        <TextBlock Text="Single Player Config:" />

        <StackPanel>
            <TextBlock Text="Display Name:" FontSize="16" />
            <TextBox PlaceholderText="&lt;Saved or Generated&gt;" />
        </StackPanel>

        <Grid ColumnDefinitions="*,4,*">
            <Button Content="&lt;- Back" />
            <Button Grid.Column="2" Content="Start!" />
        </Grid>
    </StackPanel>

</UserControl>
