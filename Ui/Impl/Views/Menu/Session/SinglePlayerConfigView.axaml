<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:EnsembleRoot.Ui.Impl.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="EnsembleRoot.Ui.Impl.Views.SinglePlayerConfigView"
    x:DataType="vm:SinglePlayerConfigViewModel"
    TextOptions.TextRenderingMode="Antialias"
    FontSize="24" FontWeight="ExtraLight">

    <StackPanel
        Spacing="8"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        MaxWidth="384">

        <TextBlock Text="Single-Player Config:" />

        <StackPanel>
            <TextBlock Text="Display Name (Alphanumeric, &#x2264;24):" FontSize="16" />

            <TextBox
                Text="{Binding DisplayName}"
                PlaceholderText="&lt;Short GUID&gt;"
                ToolTip.Tip="The name shown on your character. Remembered for next time.&#x0a;Leave empty to derive one from your player ID."
                MaxLength="24" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button
                Content="&lt;- Back"
                Command="{Binding GoBackCommand}"
                ToolTip.Tip="Goes back. (Bound to Backspace)" />

            <Border Grid.Column="1" Classes="primary">
                <Button
                    Content="Start!"
                    Command="{Binding StartCommand}"
                    ToolTip.Tip="Starts a new single-player session." />
            </Border>
        </Grid>
    </StackPanel>

</UserControl>
