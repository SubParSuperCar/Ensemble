{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Expressions",
      "Serilog.Sinks.File.Header"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Hardware.Info": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{ {@t: @t, @l: @l, @m: @m, @x: @x, ..@p} }\n"
          },
          "fileSizeLimitBytes": 1073741824,
          "buffered": false,
          "shared": false,
          "flushToDiskInterval": "00:00:02",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "retainedFileTimeLimit": "30.00:00:00",
          "hooks": "Root.Scripts.Logging.Impl.Hooks::Header, Game"
        }
      }
    ]
  }
}
