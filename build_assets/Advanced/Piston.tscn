AssetId = 20
AssetName = &"Piston"
Description = &"Pushes its plate out to its target length while its extend key is held (T by default), and back in with its retract key (G), like a hydraulic ram; released, it retracts unless it holds. Lengths are end to end, in cubes (it\'s one cube long when in), speed in cubes per second, and force in newtons, so a heavy enough load pushes it back."
Properties = Dictionary[StringName, Variant]({
&"autoRetract": true,
&"extendKey": 84,
&"force": 1000.0,
&"retractKey": 71,
&"speed": 1.0,
&"targetLength": 2.0,
&"toggles": false
})
