; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ensemble"
run/main_scene="uid://cfj5hy6hy0a7r"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.043137256, 0.09019608, 0.15686275, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://k13r5j8hdurp"
config/icon="uid://k13r5j8hdurp"
boot_splash/minimum_display_time=1000

[autoload]

AvaloniaLoader="uid://nm7jxpbwiydj"
SeriLogger="uid://dn0wmf1esf74o"
Watchdog="uid://cf8i8vhvgsrri"
Core="*uid://chxcanm6o3piw"
SessionManager="*uid://cjg5254v7pqql"
ToolManager="*res://tool/ToolManager.cs"
SysInfoLogger="uid://b1jtggnbn6gd2"
ExeHasher="uid://defjcppyvsxus"
DiscordRpc="uid://dgqr266h0mo27"

[debug]

settings/stdout/verbose_stdout.editor=true
settings/stdout/print_fps.editor=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=3
window/size/mode.editor=0

[dotnet]

project/assembly_name="Game"
project/assembly_reload_attempts=1

[editor_plugins]

enabled=PackedStringArray("res://addons/rider-plugin/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

