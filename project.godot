[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Character"
3d_physics/layer_3="Static Instances"
3d_physics/layer_4="Dynamic Instances"

[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=100
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/temporary_memory_buffer_size=48
jolt_physics_3d/limits/max_bodies=16384
jolt_physics_3d/limits/max_contact_constraints=32768
3d/default_gravity=9.80665
common/physics_interpolation=true

[rendering]

rendering_device/fallback_to_d3d12=false
rendering_device/fallback_to_opengl3=false
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/use_physical_light_units=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
textures/default_filters/texture_mipmap_bias=-0.375
environment/defaults/default_clear_color=Color(0.08627451, 0.08627451, 0.11372549, 1)
anti_aliasing/quality/screen_space_aa=2
