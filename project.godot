; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ensemble"
run/main_scene="uid://ddgi4ajn3rnnq"
config/features=PackedStringArray("4.7", "C#", "Mobile")
boot_splash/bg_color=Color(0.043137256, 0.09019608, 0.15686275, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://k13r5j8hdurp"
config/icon="uid://k13r5j8hdurp"
boot_splash/minimum_display_time=100

[autoload]

AvaloniaLoader="uid://bvmhyw4rgjd4t"

[debug]

settings/stdout/verbose_stdout.editor=true
settings/stdout/print_fps.editor=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=3
window/size/mode.editor=0

[dotnet]

project/assembly_name="Game"
project/assembly_reload_attempts=1

[editor_plugins]

enabled=PackedStringArray("res://addons/rider-plugin/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Character"

[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
lights_and_shadows/use_physical_light_units=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.08627451, 0.08627451, 0.11372549, 1)
anti_aliasing/quality/screen_space_aa=1
