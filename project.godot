config_version=5

[application]

config/name="Ensemble"
run/main_scene="uid://cfj5hy6hy0a7r"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/low_processor_mode=true

[autoload]

Avalonia="uid://b7iofxf07ba7v"
Watchdog="uid://0tvgo7nfrgu5"
StdOut="uid://oyno5534wd27"
Core="uid://c88mfna0wvuv0"
Host="uid://cfyi6ivoprayx"
Ui="uid://bvkgvmmep2hrk"

[debug]

settings/stdout/print_fps=true
settings/stdout/verbose_stdout.editor=true

[display]

