; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ensemble"
config/description="Ensemble - A multiplayer, collaborative sandbox building game made with Godot 4, C#, .NET, and Avalonia 12.
https://github.com/SubParSuperCar/Ensemble"
config/version="0.55.6"
run/main_scene="uid://ddgi4ajn3rnnq"
config/use_custom_user_dir=true
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "C#", "Mobile")
boot_splash/bg_color=Color(0.043137256, 0.09019608, 0.15686275, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://wm30e5juwv1l"
config/icon="uid://wm30e5juwv1l"
boot_splash/minimum_display_time=100

[audio]

manager/sound/bus="Sound"
manager/sound/pool_1D_size=4
manager/sound/pool_2D_size=1
manager/sound/pool_3D_size=1
manager/music/bus="Music"
manager/sound/max_polyphony=6

[autoload]

AvaloniaLoader="uid://bvmhyw4rgjd4t"
SoundManager="*uid://sgxo2a017ehn"
MusicManager="*uid://b3612i7nyqsva"

[debug]

file_logging/log_path="user://godot_logs/godot.log"
gdscript/warnings/directory_rules={
"res://addons": 1
}
settings/stdout/verbose_stdout.editor=true
settings/stdout/print_fps.editor=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/size/sharp_corners=true
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=3
window/size/mode.editor=0

[dotnet]

project/assembly_name="EnsembleGame"
project/assembly_reload_attempts=1

[editor_plugins]

enabled=PackedStringArray("res://addons/resonate/plugin.cfg", "res://addons/rider-plugin/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

