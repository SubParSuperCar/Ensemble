<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Root.Ui.Impl.App"
    RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFont">
                avares://Fonts.Avalonia.JetBrainsMono/Assets#JetBrains Mono
            </FontFamily>

            <x:Double x:Key="AppFontSize">16</x:Double>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LoadingIndicators.Avalonia/LoadingIndicators.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush
                x:Key="TranslucentBackgroundBrush"
                Color="{DynamicResource ThemeBackgroundColor}"
                Opacity="0.5" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />

        <Style Selector=":is(TopLevel)">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
            <Setter Property="Background" Value="{StaticResource TranslucentBackgroundBrush}" />
        </Style>

        <Style Selector="ToolTip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0" />

            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0.25" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToolTip:open /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Application.Styles>

</Application>
