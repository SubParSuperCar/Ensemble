<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Root.Ui.Impl.ViewModels"
    xmlns:ae="using:AvaloniaEdit"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="Root.Ui.Impl.Views.ConsoleView"
    x:DataType="vm:ConsoleViewModel"
    TextOptions.TextRenderingMode="Antialias">

    <Border
        BorderBrush="YellowGreen"
        BorderThickness="2">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" MinWidth="384" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="256" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                x:Name="OutputScroll"
                HorizontalScrollBarVisibility="Disabled">

                <SelectableTextBlock
                    Text="{Binding Output}"
                    FontSize="11"
                    Padding="1"
                    Background="Black"
                    Foreground="White"
                    SelectionBrush="White"
                    SelectionForegroundBrush="Black"
                    TextWrapping="Wrap" />
            </ScrollViewer>

            <GridSplitter
                Grid.Column="1"
                Width="4"
                Background="YellowGreen"
                ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <ae:TextEditor
                    Name="Editor"
                    Document="{Binding Source}"
                    Background="{DynamicResource TranslucentBackgroundBrush}"
                    ShowLineNumbers="True"
                    WordWrap="True"
                    FontSize="13" />

                <Border
                    Margin="0,0,22,4"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderBrush="DodgerBlue"
                    BorderThickness="1">

                    <Button
                        Content="Execute Script"
                        Command="{Binding ExecuteCommand}"
                        ToolTip.Tip="Executes the entered script source code."
                        Foreground="White" Background="Black" />
                </Border>
            </Grid>
        </Grid>
    </Border>

</UserControl>
