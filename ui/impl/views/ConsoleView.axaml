<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Root.Ui.Impl.ViewModels"
    xmlns:ae="using:AvaloniaEdit"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="Root.Ui.Impl.Views.ConsoleView"
    x:DataType="vm:ConsoleViewModel"
    TextOptions.TextRenderingMode="Antialias">

    <Border
        BorderBrush="GreenYellow"
        BorderThickness="2">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.0625*" MinWidth="384" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="256" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ScrollViewer
                    x:Name="OutputScroll"
                    HorizontalScrollBarVisibility="Disabled">

                    <SelectableTextBlock
                        Name="Output"
                        Text="{Binding Output}"
                        Background="Black" Foreground="White"
                        SelectionBrush="White" SelectionForegroundBrush="Black"
                        Padding="1"
                        FontSize="10" FontWeight="UltraLight"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <NumericUpDown
                    Value="{Binding #Output.FontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    PlaceholderText="&lt;Font Size&gt;"
                    ToolTip.Tip="Font Size (Pixels)"
                    Background="{DynamicResource TranslucentBackgroundBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,22,4" />
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Background="YellowGreen"
                Width="4"
                ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <ae:TextEditor
                    Name="Editor"
                    Document="{Binding Source}"
                    Background="{DynamicResource TranslucentBackgroundBrush}"
                    FontSize="13"
                    WordWrap="True"
                    ShowLineNumbers="True" />

                <Border
                    BorderBrush="DodgerBlue"
                    BorderThickness="1"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,22,4">

                    <Button
                        Content="Execute Script"
                        Command="{Binding ExecuteCommand}"
                        ToolTip.Tip="Executes the entered script source code."
                        Background="Black" Foreground="White" />
                </Border>
            </Grid>
        </Grid>
    </Border>

</UserControl>
