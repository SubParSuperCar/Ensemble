<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Root.Ui.Impl.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="Root.Ui.Impl.Views.PlayerListView"
    x:DataType="viewModels:PlayerListViewModel">

    <Grid
        RowDefinitions="Auto,*"
        ToolTip.Tip="Player List"
        Background="{DynamicResource TranslucentBackgroundBrush}">

        <Grid ColumnDefinitions="*,*,Auto">
            <TextBlock Text="Moniker&#x0a; &#x2198;" />
            <TextBlock Grid.Column="1" Text="Player List" />
            <TextBlock Grid.Column="2" Text="Peer ID&#x0a;&#x2193; " TextAlignment="Right" />
        </Grid>

        <ListBox
            Grid.Row="1"
            ItemsSource="{Binding Players}"
            SelectedItem="{Binding SelectedPlayer}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,16,Auto">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding PeerId, StringFormat='{}{0:000}'}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</UserControl>
