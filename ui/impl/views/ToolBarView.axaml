<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Root.Ui.Impl.Views.ToolBarView"
    FontSize="20" FontWeight="ExtraLight">

    <Border Background="{DynamicResource TranslucentBackgroundBrush}" Padding="4">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <ToggleButton Content="Place Tool (1)" ToolTip.Tip="Toggles the build tool. (Bound to One)" />
            <ToggleButton Content="Delete Tool (2)" ToolTip.Tip="Toggles the delete tool. (Bound to Two)" />

            <CheckBox
                Content="MutEx"
                ToolTip.Tip="Mutual Exclusion: Toggles whether multiple tools can't be enabled at the same time."
                Margin="4,0" />
        </StackPanel>
    </Border>

</UserControl>
